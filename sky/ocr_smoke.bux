# A smoke run of OCR fine-tuning on one GPU: Qwen3.5-0.8B from its released weights,
# on rendered pages (sky/pages.py), training everything against a frozen encoder.
use "qwen3.5_0.8b"

tokenizer = tokenizer(name="Qwen/Qwen3.5-0.8B", eos="<|im_end|>")
pages     = chat(path="data/ocr/pages.parquet", images=images(max_pixels=1048576))
weights   = hf(name="Qwen/Qwen3.5-0.8B")

data      = pages(split=[0, 0.95])
patches_per_row = 4096
seq_len   = 2048
batch     = 8
steps     = 50
optimizer = adamw(lr=1e-5, weight_decay=0.0)
schedule  = cosine(warmup=5)
frozen    = all: [] | encoder: [vision]
log       = log(every=5)
checkpoint = checkpoint(every=50)

eval = eval(data=pages(split=[0.95, 1]), every=25)
