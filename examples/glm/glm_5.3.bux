# GLM-5.3 (Z.ai, 2026): a 753B MoE on the DeepSeek-V3.2 recipe, MLA with DeepSeek Sparse
# Attention in all 78 layers, with wider heads (192 + 64 for queries and keys, 256 for
# values) and no RoPE stretching for its 1M-token context.
#
# Most layers do not run their own indexer (IndexCache): a full layer exports its top-k
# through the `index` port, and the three layers after it attend to the same keys. The
# first 3 layers are dense. One MTP layer, with an indexer of its own, is trained as 3
# chained steps that share it (as the GLM-5 report describes).
d_model    = 6144
vocab_size = 154880

norm    = rmsnorm(eps=1e-5)
attn    = mla(num_heads=64, q_lora_rank=2048, kv_lora_rank=512, qk_nope_head_dim=192,
              qk_rope_head_dim=64, v_head_dim=256, rope=rope(base=8000000),
              indexer=indexer(num_heads=32, head_dim=128, top_k=2048))
dense   = gated_mlp(intermediate_size=12288, activation=swish)
experts = moe(num_experts=256, top_k=8, num_shared_experts=1, router=sigmoid,
              routed_scaling_factor=2.5, load_balancing=aux_free,
              expert=gated_mlp(intermediate_size=2048, activation=swish))

layer(mixer, ffn=experts) = [norm mixer] [norm ffn]
A = layer(attn(index=@topk), dense)
F = layer(attn(index=@topk))
S = layer(attn(index=$topk))

shared out = head
shared mtp = $h! nextn(norm=norm) layer(attn) norm @h out

model = embed "AAA" "SSS" "FSSS"^18 norm @h out mtp^3
