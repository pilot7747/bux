# The four-node suite: the baseline on 32 GPUs of four hosts, 8 rows a GPU. FSDP over
# all 32; HSDP, sharded within a host and copied across the four; the MoE, sorted
# under HSDP, and by EP within a host (a ragged all-to-all, at a capacity of 1.25);
# and a pipeline of a stage a host, FSDP within each, in 16 microbatches: 1f1b on the
# stages it balances ([5, 5, 5, 1]) and on even ones, and gpipe on even ones.
#
#   python scripts/benchmark.py run examples/benchmarks/four_nodes.bux --out new.json   # on each host
use baseline

model   = fsdp:    embed A^16 norm head
        | hsdp:    embed A^16 norm head
        | moe:     embed E^16 norm head
        | moe_ep:  embed E^16 norm head
        | pp:      embed A^16 norm head
        | pp_even: embed A^16 norm head
        | gpipe:   embed A^16 norm head
batch   = 256

mesh    = fsdp:    mesh(fsdp=32)
        | hsdp:    mesh(data=4, fsdp=8)
        | moe:     mesh(data=4, fsdp=8)
        | moe_ep:  mesh(data=4, expert=8)
        | pp:      mesh(stage=4, fsdp=8)
        | pp_even: mesh(stage=4, fsdp=8)
        | gpipe:   mesh(stage=4, fsdp=8)
methods = fsdp:    methods
        | hsdp:    methods
        | moe:     methods(moe=sorted)
        | moe_ep:  methods(moe=ragged_all_to_all, capacity=1.25)
        | pp:      methods(repeat=scan, microbatches=16)
        | pp_even: methods(repeat=scan, microbatches=16, stages=[4, 4, 4, 4])
        | gpipe:   methods(repeat=scan, microbatches=16, pipeline="gpipe")
