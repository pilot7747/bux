# Qwen3-30B-A3B on a node of 8 GPUs, as Megatron-Bridge's performance summary
# benchmarks it (26.06: 40,769 tokens a second a GPU on 8 B300s, MXFP8, EP=8, a global
# batch of 512 rows of 4096 in microbatches of 8 rows a GPU): the matmuls in MXFP8, the
# experts sorted under FSDP, and split over the GPUs by NCCL EP. Megatron's numbers
# route by random logits (moe_router_force_load_balancing), and so does this run.
#
#   python scripts/benchmark.py run examples/benchmarks/megatron.bux --out new.json
use qwen3_30b_a3b

experts.random_logits = true

model   = sorted:  embed block^48 norm head
        | nccl_ep: embed block^48 norm head
mesh    = sorted:  mesh(fsdp=8)
        | nccl_ep: mesh(expert=8)
# sorted gathers a layer at a time: a copy of the whole model does not fit beside
# a microbatch's activations.
methods = sorted:  methods(moe=sorted, microbatches=8, gather=layer)
        | nccl_ep: methods(moe=nccl_ep, capacity=1.25, microbatches=8)

data      = synthetic
optimizer = adamw(lr=3e-4)
seq_len   = 4096
batch     = 512
steps     = 12
log       = log(every=3)
precision = precision(compute=bfloat16, matmuls=mxfp8)
