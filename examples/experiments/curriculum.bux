# The smoke run's model through a curriculum: its batch ramps up from 4 rows to 16
# over the first 20 steps, then its rows grow from 64 tokens to 128 and 256, fewer of
# them a step, so that a step's tokens stay 1,024. Each new shape compiles the step
# again. A few seconds on a laptop.
#
#   bux check examples/experiments/curriculum.bux
#   bux train examples/experiments/curriculum.bux
d_model    = 64
vocab_size = 512

norm  = rmsnorm
attn  = gqa(num_heads=4, num_kv_heads=2, rope=rope())
ffn   = gated_mlp(intermediate_size=4 * d_model, activation=swish)
block = [norm attn] [norm ffn]
model = embed block^2 norm head(tied=true)

data       = synthetic
optimizer  = adamw(lr=3e-3)
schedule   = wsd(warmup=10)
seq_len    = 64
batch      = 16
batch_ramp = ramp(start=4, steps=20)
steps      = 80
curriculum = [phase(at=0.5, seq_len=128, batch=8),
              phase(at=0.75, seq_len=256, batch=4)]
