# Milestone 2025, Qwen3-Next (Qwen Team, 2025), as the tutorial's 2026 family
# (examples/experiments/old_vs_new/new_2026.bux): three Gated DeltaNet layers for every
# attention layer, the attention with 2 key and value heads of 256, QK-norm, a sigmoid
# gate on its output and RoPE at base 10M on a quarter of its dims; zero-centered
# RMSNorms; a mixture of 256 experts after every mixer, 7 of them a token by softmax
# scores beside a gated shared expert; one MTP module. Every expert is an eighth of the
# dense families' SwiGLU, so a token goes through as much MLP (Qwen3-Next: 10 of 512 a
# quarter of the width wide, and a shared one).
d_model    = 768
vocab_size = 50304
layers     = d_model // 64

swiglu_width = (8 * d_model + 96) // 192 * 64
# An expert an eighth as wide, in whole blocks of 64, as the grouped GEMMs take them.
expert_width = (swiglu_width + 256) // 512 * 64

qn_norm    = rmsnorm(zero_centered=true)
qn_delta   = gdn(num_heads=d_model // 128, num_v_heads=d_model // 64, head_dim=128)
qn_attn    = gqa(num_heads=d_model // 128, num_kv_heads=2, head_dim=256, gated=true,
                 qk_norm=qn_norm, rope=rope(base=10000000, fraction=0.25))
qn_experts = moe(num_experts=256, top_k=7, num_shared_experts=1, shared_expert_gate=true,
                 aux_loss_coef=1e-3,
                 expert=gated_mlp(intermediate_size=expert_width, activation=swish))

qn_layer(mixer) = [qn_norm mixer] [qn_norm qn_experts]

shared qn_out = head
qn_mtp = $h nextn(norm=qn_norm) qn_layer(qn_attn) qn_norm qn_out

qwen3next = embed (qn_layer(qn_delta)^3 qn_layer(qn_attn))^(layers // 4)
            qn_norm @h qn_out qn_mtp
model     = qwen3next
