# The residual stream, one change at a time from the 2021 reference (gpt3_rope.bux: the 2020 baseline with RoPE)'s plain sum,
# x + f(x) (gpt3_2020.bux): residual algebras that widen it, mix it or weigh it, each
# set for every branch of the model. Arms: era, source, what it was claimed for.
use gpt3_rope
use timeline_code
use rungs

residual = base: none
         # 2025 Zhu et al. (hyper-connections): 4 copies of the stream, learned reads,
         # writes and mixing; quality
         | hc: hc(expansion=4)
         # 2026 DeepSeek mHC, DeepSeek-V4.1, GLM-5.3-Flash: the mixing doubly stochastic;
         # stability at scale
         | mhc: mhc(expansion=4)
         # 2026 Kimi Attention Residuals, Kimi K3: a softmax over depth, 8 blocks of
         # branches; quality (PreNorm dilution)
         | attnres: attnres(block_size=layers // 4)
         # 2026 Qwen3.8-Flash-Next: 4 gated, normalized copies, which replace the
         # pre-norms; quality, stability
         | gr: gr(expansion=4, rank=d_model // 8)
         # 2026 Muse Spark: a * x + b * f(x) with a^2 + b^2 = 1 per channel; stability
         | vpgate: vpgate(temperature=0.3)

model = base: model | hc: model | mhc: model | attnres: model
      | gr: embed ([attn] [ffn])^layers head(tied=true)
      | vpgate: model
