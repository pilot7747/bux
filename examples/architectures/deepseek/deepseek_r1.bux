# DeepSeek-R1 (DeepSeek, 2025): the reasoning model trained from DeepSeek-V3-Base with
# reinforcement learning, so the architecture is exactly DeepSeek-V3's: MLA in all 61
# layers, 3 dense layers, then 58 MoE layers with sigmoid routing over 8 expert groups.
# This file also has the multi-token prediction (MTP) module that deepseek_v3.bux leaves
# out: one more layer predicts the token after next from the final hidden state and the
# embedding of the next token, through the same head.
d_model    = 7168
vocab_size = 129280

norm    = rmsnorm
attn    = mla(num_heads=128, q_lora_rank=1536, kv_lora_rank=512,
              rope=rope(layout=interleaved,
                        scaling=yarn(factor=40, original_max_len=4096,
                                     attention_factor_on=softmax)))
dense   = gated_mlp(intermediate_size=18432, activation=swish)
experts = moe(num_experts=256, top_k=8, num_shared_experts=1, router=sigmoid,
              routed_scaling_factor=2.5, num_groups=8, top_k_groups=4, load_balancing=aux_free,
              expert=gated_mlp(intermediate_size=2048, activation=swish))

layer(ffn) = [norm attn] [norm ffn]

shared out = head
mtp = $h nextn layer(experts) norm out

model = embed layer(dense)^3 layer(experts)^58 norm @h out mtp
