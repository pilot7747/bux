# Olmo 3 32B (Allen AI, 2025): Olmo 3 7B's design at OLMo 2 32B's size, 64 layers 5120
# wide with 40 query heads over 8 key and value heads of 128. Olmo 3 32B Think, and
# Olmo 3.1 32B Think and Instruct, are post-trained from this base.
d_model    = 5120
vocab_size = 100278

init   = normal(std=0.02, truncate=3)
norm   = rmsnorm(eps=1e-6)
attn   = gqa(num_heads=40, num_kv_heads=8, qk_norm=norm, qk_norm_all_heads=true)
local  = attn(sliding_window_size=4096, rope=rope(base=500000))
global = attn(rope=rope(base=500000, scaling=yarn(factor=8, original_max_len=8192)))
ffn    = gated_mlp(intermediate_size=27648, activation=swish)

layer(mixer) = [mixer norm] [ffn norm]
L = layer(local)
G = layer(global)

model = embed "LLLG"^16 norm head
