 "node:n.1.0.0.0.0": {
  "title": "RMSNorm",
  "subtitle": "rmsnorm \u00b7 norm",
  "doc": "Layer normalization (Ba et al., 2016) or RMSNorm (Zhang & Sennrich, 2019).\n\n``layernorm`` subtracts the mean over the width and divides by the standard\ndeviation; ``rmsnorm`` only divides by the root mean square. Then each multiplies\nby a learned gain per channel (`affine`) and adds a learned bias (`bias`). A norm\nis a layer, ``[norm attn]``, and a setting of layers that normalize something of\ntheir own, as ``gqa(qk_norm=rmsnorm)``.",
  "where": {
   "span": [
    98,
    122
   ],
   "file": null,
   "line": 5
  },
  "fields": [
   {
    "key": "eps",
    "type": "float",
    "doc": "Added to the variance (rmsnorm: mean square) before its root.",
    "required": false,
    "default": "1e-06",
    "value": "1e-05",
    "written": "1e-5",
